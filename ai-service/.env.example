# VaidyaAI AI service - Module 4 (OCR & Extraction) + Module 5 (Features)
# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Service-to-service authentication (REQUIRED) ------------------------
# The ONLY legitimate caller of this service is the Node backend. It sends this
# shared secret in the `X-Service-Key` header on every request to
# /api/v1/ocr/extract, /api/v1/features/engineer and /api/v1/features/catalog.
# (/api/v1/health is deliberately open, so the backend can health-check it.)
#
# Set the IDENTICAL value in the backend's own AI_SERVICE_API_KEY.
# Minimum 32 characters. Generate one, do not invent one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# THE SERVICE FAILS CLOSED. If this is unset (or blank, or under 32 chars) the
# service REFUSES TO START. An unset key never means "no auth required".
AI_SERVICE_API_KEY=replace-me-with-at-least-32-random-characters

# LOCAL DEVELOPMENT ESCAPE HATCH - DO NOT SET IN ANY SHARED ENVIRONMENT.
# Setting this to true starts the service with NO authentication at all: any
# caller who can reach the port can submit medical documents and read
# extractions. It prints a loud SECURITY WARNING banner on every startup.
# If AI_SERVICE_API_KEY is also set, the key WINS and this flag does nothing.
# ALLOW_UNAUTHENTICATED=false

# --- Gemini (required) ---------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key-here

# Vision model used for extraction. Verified present in the Google
# Generative AI model list.
GEMINI_MODEL=gemini-3.6-flash

# Per-request timeout. Every Gemini call is bounded by this, retried at most
# GEMINI_MAX_RETRIES times, once per page -- so the worst case for one extract
# request is:
#   (RETRIES x TIMEOUT + backoff) x MAX_PAGE_COUNT
# With the defaults below that is ~3638s (~61 min). The backend must set its
# HTTP client timeout above whatever this works out to. See README.
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0
# Low temperature: extraction must be deterministic, not creative.
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=32768

# --- OpenRouter (optional) -----------------------------------------------
# Powers the CHATBOT (free models; Gemini is never used for chat) and is the
# backup writer for explanations when Gemini's daily quota is spent.
# Get a key at https://openrouter.ai/keys . Without it the chat answers
# "not available right now" and nothing else changes.
OPENROUTER_API_KEY=

# --- File intake limits --------------------------------------------------
MAX_FILE_SIZE_BYTES=15728640   # 15 MB
MAX_PAGE_COUNT=10
PDF_RENDER_DPI=200
MAX_IMAGE_EDGE_PIXELS=2200

# --- Extraction ----------------------------------------------------------
# Overall confidence at or below this adds a warning to the response.
LOW_CONFIDENCE_THRESHOLD=0.6

# --- Service -------------------------------------------------------------
APP_NAME=vaidyaai-ocr-service
ENVIRONMENT=development
LOG_LEVEL=INFO
# Load the ML models and knowledge index at startup instead of on the first
# analysis. Turn on for slow hosts (Render's free plan); off keeps local
# startup and the tests instant.
PRELOAD_ON_STARTUP=false
# Comma-separated BROWSER origins. The Node backend is a SERVER-SIDE caller and
# needs none of these -- CORS does not apply to server-to-server requests.
# Leave EMPTY unless a browser must call this service directly, which it must
# not (it would then be holding AI_SERVICE_API_KEY).
CORS_ALLOW_ORIGINS=

# --- Tests ---------------------------------------------------------------
# Set to 1 (with a real GEMINI_API_KEY) to enable the opt-in live API test.
RUN_LIVE_TESTS=0
