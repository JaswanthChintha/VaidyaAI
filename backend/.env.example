# ---------------------------------------------------------------------------
# VaidyaAI backend - environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- Proxy trust (SECURITY-CRITICAL) ---------------------------------------
# Controls Express' `trust proxy`. `req.ip` is the rate limiter's key, and when
# this is enabled Express derives req.ip from the client-supplied
# X-Forwarded-For header.
#
#   MUST be left false/unset when the app is exposed directly, otherwise ANY
#   caller can rotate X-Forwarded-For and bypass rate limiting completely.
#
#   MUST be set to the real number of proxy hops when deployed behind a load
#   balancer / reverse proxy (nginx, ELB, Cloudflare, Heroku = 1), otherwise
#   every request appears to come from the proxy's IP and one abusive client
#   rate-limits all of your users.
#
# Getting this wrong in EITHER direction breaks rate limiting. Accepted values:
# false (default) | true | an integer hop count | any Express trust-proxy
# expression (e.g. "loopback", "10.0.0.0/8").
TRUST_PROXY=false

# --- Database (required) ---------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/vaidyaai

# Optional. DNS servers for Node's own resolver, comma-separated IPs. Set this
# when a `mongodb+srv://` link fails with "querySrv ECONNREFUSED": some Wi-Fi
# routers refuse the SRV lookup such a link needs. Leave unset to use the
# system's DNS.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- JWT (required) --------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Enforced at startup: minimum 32 characters, and the two secrets MUST differ.
JWT_SECRET=replace-with-a-long-random-access-token-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-long-random-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=vaidyaai
JWT_AUDIENCE=vaidyaai-clients

# --- Password hashing ------------------------------------------------------
# bcrypt ignores input past 72 bytes, so passwords longer than that are
# rejected at validation rather than silently truncated.
BCRYPT_COST_FACTOR=12

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# --- Module 3: report upload & storage -------------------------------------
# Which storage adapter backs report FILES. Metadata always lives in MongoDB.
#   local -- files on this machine's disk, under UPLOAD_ROOT (development).
#   mongo -- files in MongoDB itself (GridFS). Use this on any host whose disk
#            is wiped on restart (e.g. Render's free plan), or every uploaded
#            report is lost the first time the service sleeps.
# See src/storage/ for how to add another driver as a one-file change.
STORAGE_DRIVER=local

# Absolute or relative directory holding uploaded report files. It MUST NOT be
# inside any statically served directory - files are only ever returned through
# the authenticated, owner-scoped download route, which forces
# `Content-Disposition: attachment`. Defaults to backend/storage/uploads, which
# is gitignored. Contains medical data: back it up and restrict its permissions.
UPLOAD_ROOT=./storage/uploads

# Hard cap on a single uploaded file, in bytes (default 10 MiB). Exceeding it is
# a clean 413. Files are buffered in memory up to this size, so raising it also
# raises per-request memory use.
UPLOAD_MAX_BYTES=10485760

# Uploads are throttled separately from the auth limiters - an upload costs far
# more than a login attempt, and neither should be able to exhaust the other.
UPLOAD_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MS=900000

# --- ai-service: Modules 4 (OCR) + 5 (feature engineering) -----------------
# The Python/FastAPI service in ../ai-service. The backend orchestrates the
# pipeline; that service does the extraction and feature engineering.
#
# FAIL-CLOSED, both directions:
#   * AI_SERVICE_URL set + AI_SERVICE_API_KEY empty  -> the backend REFUSES TO
#     START. Sending medical documents to an unauthenticated endpoint is never
#     a fallback.
#   * AI_SERVICE_API_KEY shorter than 32 characters  -> refuses to start. The
#     ai-service enforces the same minimum.
#   * Neither set                                    -> supported. Modules 1-3
#     behave exactly as before and POST /reports/:id/analyze answers 503.
#
# The SAME key must be configured on both services. There is no rotation
# window: changing it requires restarting both together.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=replace-with-a-long-random-shared-service-key-min-32-chars

# Client timeout for an extraction call, in ms (default 300000 = 5 min).
#
# IMPORTANT: tune this together with the ai-service. A happy-path extraction is
# ~20 s, but the ai-service's WORST case with its shipped defaults is ~61 min
# ((GEMINI_MAX_RETRIES x GEMINI_TIMEOUT_SECONDS + backoff) x MAX_PAGE_COUNT).
# The ai-service README recommends GEMINI_TIMEOUT_SECONDS=45 and
# GEMINI_MAX_RETRIES=2 (~15 min worst case). This value must exceed whatever
# the deployed ai-service is actually configured for, or a slow multi-page scan
# fails here while the Python side is still working (and still spending quota).
AI_SERVICE_TIMEOUT_MS=300000

# Health probe timeout - deliberately short; /health must answer immediately.
AI_SERVICE_HEALTH_TIMEOUT_MS=3000

# THE FAST STAGES MUST NOT INHERIT THE EXTRACTION TIMEOUT. Validation (Module
# 6), the clinical rule engine (Module 8) and the ML predictors (Modules 9/10)
# are pure computation over an already-extracted feature set and return in
# milliseconds (measured live at 10 ms / 14 ms / 1657 ms). Giving them five
# minutes would pin three more Node handles for five minutes each against a
# wedged service, after the expensive stage had already succeeded.
AI_SERVICE_STAGE_TIMEOUT_MS=30000
# Per-stage overrides; each defaults to AI_SERVICE_STAGE_TIMEOUT_MS.
# AI_SERVICE_VALIDATE_TIMEOUT_MS=30000
# AI_SERVICE_RULES_TIMEOUT_MS=30000
# AI_SERVICE_ML_TIMEOUT_MS=30000

# Extra attempts after the first, for TRANSIENT failures only (connection
# refused/reset, timeout, 429, 5xx). A 401 and a 422 are never retried.
AI_SERVICE_RETRIES=1
AI_SERVICE_RETRY_DELAY_MS=500

# For a host that puts an idle ai-service to sleep (e.g. Render's free plan):
# before each analysis, ask /health every AI_SERVICE_WAKE_INTERVAL_MS until it
# answers, for at most AI_SERVICE_WAKE_WAIT_MS. 0 = don't wait (always-on host).
AI_SERVICE_WAKE_WAIT_MS=0
AI_SERVICE_WAKE_INTERVAL_MS=5000

# How long a report may sit in `processing` before another analyze request may
# take the lock over. Covers a process that died mid-analysis; must be well
# above a realistic extraction time. Default 10 minutes.
AI_SERVICE_LOCK_TTL_MS=600000

# Analysis is the most expensive endpoint in the app (a multi-second LLM call
# per request) and the ai-service has NO rate limiting of its own, so this is
# the only thing standing between a compromised account and unbounded Gemini
# spend. Keep it small.
ANALYSIS_RATE_LIMIT_MAX=20
ANALYSIS_RATE_LIMIT_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# Placeholders for LATER modules. Not read or used by the backend.
# ---------------------------------------------------------------------------
# The Gemini key belongs to the ai-service, not here - the backend never calls
# an LLM directly.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
